generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  driver
  admin
}

enum UserStatus {
  active
  banned
}

enum DriverStatus {
  pending
  approved
  rejected
}

enum OrderStatus {
  pending
  paid
  dispatched
  arrived
  loading
  delivering
  completed
  cancelled
  disputed
}

enum PaymentMethod {
  wechat
  alipay
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum SettlementStatus {
  pending
  settled
}

enum ComplaintStatus {
  pending
  resolved
  dismissed
}

enum WalletTransactionType {
  topup
  refund
}

enum CouponType {
  fixed
  percent
}

enum UserCouponStatus {
  unused
  used
}

enum PointTransactionType {
  earn
  redeem
}

enum InvoiceType {
  personal
  company
}

enum InvoiceStatus {
  pending
  issued
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String                 @id @default(cuid())
  walletId       String                 @map("wallet_id")
  type           WalletTransactionType
  amount         Decimal                @db.Decimal(10, 2)
  balanceBefore  Decimal                @db.Decimal(10, 2) @map("balance_before")
  balanceAfter   Decimal                @db.Decimal(10, 2) @map("balance_after")
  createdAt      DateTime               @default(now()) @map("created_at")


  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("wallet_transactions")
}

model User {
  id             String     @id @default(cuid())
  phone          String     @unique
  name           String?
  role           UserRole   @default(customer)
  avatar         String?
  defaultAddress String?
  status         UserStatus @default(active)
  createdAt      DateTime   @default(now()) @map("created_at")

  updatedAt      DateTime   @updatedAt @map("updated_at")

  driver      Driver?
  orders      Order[]        @relation("UserOrders")
  payments    Payment[]
  reviews     Review[]
  complaints  Complaint[]
  addresses   UserAddress[]
      wallet      Wallet?
	  feedbacks   Feedback[]
	  userCoupons  UserCoupon[]
	  points       UserPoints?
	  pointTransactions PointTransaction[]
	  invoices     Invoice[]

  @@map("users")
}

model UserAddress {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  label        String?
  address      String
  lng          Float
  lat          Float
  contactName  String  @map("contact_name")
  contactPhone String  @map("contact_phone")
  isDefault    Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model Driver {
  id          String       @id @default(cuid())
  userId      String       @unique @map("user_id")
  realName    String?      @map("real_name")
  idCard      String?      @map("id_card")
  licenseInfo String?      @map("license_info")
  status      DriverStatus @default(pending)
  currentLng  Float?       @map("current_lng")
  currentLat  Float?       @map("current_lat")
  remark      String?
  createdAt   DateTime     @default(now()) @map("created_at")

  updatedAt   DateTime     @updatedAt @map("updated_at")

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?
  orders   Order[]
  reviews  Review[]
  payments Payment[]
	  settlements  Settlement[]

  @@map("drivers")
}

model Vehicle {
  id              String     @id @default(cuid())
  driverId        String     @unique @map("driver_id")
  vehicleTypeCode String     @map("vehicle_type_code")
  brand           String
  model           String
  color           String
  plateNumber     String     @map("plate_number")
  length          Float
  width           Float
  height          Float
  vin             String
  photos          String[]
  status          String     @default("active")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

model VehicleType {
  id           String         @id @default(cuid())
  name         String         @unique
  code         String         @unique
  icon         String?
  sort         Int            @default(0)
  length       Float?         @map("length_m")
  width        Float?         @map("width_m")
  height       Float?         @map("height_m")
  loadCapacity Float?         @map("load_capacity_t")
  volume       Float?         @map("volume_m3")
  createdAt    DateTime       @default(now()) @map("created_at")


  pricingRules PricingRule[]

  @@map("vehicle_types")
}

model PricingRule {
  id              String   @id @default(cuid())
  vehicleTypeCode String   @map("vehicle_type_code")
  basePrice       Int      @map("base_price")
  includedKm      Int      @map("included_km")
  pricePerKm      Float    @map("price_per_km")
  surgeRules      Json?    @map("surge_rules")
  effectiveDate   DateTime @default(now()) @map("effective_date")
  createdAt       DateTime @default(now()) @map("created_at")


  vehicleType VehicleType @relation(fields: [vehicleTypeCode], references: [code])

  @@map("pricing_rules")
}

model Order {
  id                String      @id @default(cuid())
  orderNo           String      @unique @map("order_no")
  userId            String      @map("user_id")
  driverId          String?     @map("driver_id")
  vehicleTypeCode   String      @map("vehicle_type_code")
  status            OrderStatus @default(pending)

  // 取货地址
  pickupAddress     String   @map("pickup_address")
  pickupLng         Float    @map("pickup_lng")
  pickupLat         Float    @map("pickup_lat")
  pickupContactName String   @map("pickup_contact_name")
  pickupContactPhone String  @map("pickup_contact_phone")

  // 送货地址
  dropoffAddress     String   @map("dropoff_address")
  dropoffLng         Float    @map("dropoff_lng")
  dropoffLat         Float    @map("dropoff_lat")
  dropoffContactName String   @map("dropoff_contact_name")
  dropoffContactPhone String  @map("dropoff_contact_phone")

  // 计价
  distanceKm         Float    @map("distance_km")
  basePrice          Int      @map("base_price")
  distancePrice      Float    @map("distance_price")
  surgeFee           Float    @default(0) @map("surge_fee")
  userAdditionalFee  Float    @default(0) @map("user_additional_fee")
  totalPrice         Int      @map("total_price")

  // 货物
  cargoPhotos        String[] @map("cargo_photos")
  remark             String?

  // 时间
  paidAt             DateTime? @map("paid_at")
  dispatchedAt       DateTime? @map("dispatched_at")
  arrivedAt          DateTime? @map("arrived_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  updatedAt          DateTime  @updatedAt @map("updated_at")

  // 关联
  user        User       @relation("UserOrders", fields: [userId], references: [id])
  driver      Driver?    @relation(fields: [driverId], references: [id])
  payment     Payment?
  tracks      OrderTrack[]
  review      Review?
	  invoice     Invoice?
  complaints  Complaint[]

  @@map("orders")
}

model OrderTrack {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  status    String?
  lng       Float?
  lat       Float?
  createdAt DateTime @default(now()) @map("created_at")


  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_tracks")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique @map("order_id")
  userId        String        @map("user_id")
  driverId      String?       @map("driver_id")
  amount        Int           @map("amount")
  platformFee   Float         @default(0) @map("platform_fee")
  driverIncome  Float?        @map("driver_income")
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  transactionId String?       @map("transaction_id")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  updatedAt     DateTime      @updatedAt @map("updated_at")

  order  Order @relation(fields: [orderId], references: [id])
  user   User  @relation(fields: [userId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@map("payments")
}

model Settlement {
  id           String           @id @default(cuid())
  driverId     String           @map("driver_id")
  periodStart  DateTime         @map("period_start")
  periodEnd    DateTime         @map("period_end")
  orderCount   Int              @default(0) @map("order_count")
  totalAmount  Float            @map("total_amount")
  platformFee  Float            @default(0) @map("platform_fee")
  netAmount    Float            @map("net_amount")
  status       SettlementStatus @default(pending)
  settledAt    DateTime?        @map("settled_at")


  createdAt    DateTime         @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id])


  @@map("settlements")
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique @map("order_id")
  userId    String   @map("user_id")
  driverId  String   @map("driver_id")
  rating    Int
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id])


  order  Order @relation(fields: [orderId], references: [id])
  user   User  @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Complaint {
  id             String           @id @default(cuid())
  orderId        String           @map("order_id")
  complainantId  String           @map("complainant_id")
  type           String
  content        String
  status         ComplaintStatus  @default(pending)
  resolution     String?
  adminId        String?          @map("admin_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  updatedAt      DateTime         @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [complainantId], references: [id])

  @@map("complaints")
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  phone       String
  content     String
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")


  user User @relation(fields: [userId], references: [id])

  @@map("feedbacks")
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(10, 2)
  minOrderAmount  Decimal    @default(0) @db.Decimal(10, 2) @map("min_order_amount")
  validFrom       DateTime   @map("valid_from")
  validUntil      DateTime   @map("valid_until")
  usageLimit      Int        @default(100) @map("usage_limit")
  usedCount       Int        @default(0) @map("used_count")
  createdAt       DateTime   @default(now()) @map("created_at")


  userCoupons UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  couponId  String           @map("coupon_id")
  status    UserCouponStatus @default(unused)
  usedAt    DateTime?        @map("used_at")
  orderId   String?          @map("order_id")

  createdAt DateTime         @default(now()) @map("created_at")


  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@map("user_coupons")
}

model PointTransaction {
  id            String               @id @default(cuid())
  pointId       String               @map("point_id")
  userId        String               @map("user_id")
  type          PointTransactionType
  amount        Int
  balanceBefore Int                  @map("balance_before")
  balanceAfter  Int                  @map("balance_after")
  createdAt     DateTime             @default(now()) @map("created_at")


  user  User      @relation(fields: [userId], references: [id])
  point UserPoints @relation(fields: [pointId], references: [id])

  @@map("point_transactions")
}

model UserPoints {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id])
  transactions PointTransaction[]

  @@map("user_points")
}

model Invoice {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  orderId     String        @unique @map("order_id")
  type        InvoiceType
  title       String
  taxNumber   String?       @map("tax_number")
  amount      Decimal       @db.Decimal(10, 2)
  invoiceNo   String        @unique @map("invoice_no")
  status      InvoiceStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created_at")


  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@map("invoices")
}
